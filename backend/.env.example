BACKEND_PORT=3001
SURF_API_KEY=

# Server-only CoinGecko pricing. Use `demo` with api.coingecko.com or `pro` with pro-api.coingecko.com.
COINGECKO_API_KEY=
COINGECKO_API_MODE=demo

# Optional server-only conversational provider. Never use VITE_ here.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_MS=12000

# Task SIWE authentication. Local development defaults to http://localhost:5173.
# Public hosting requires an HTTPS origin and a random secret with at least 32 bytes.
PUBLIC_APP_ORIGIN=http://localhost:5173
TASK_SESSION_SECRET=
# Persistent same-host SQLite file for nonce, session, and rate-limit state.
TASK_AUTH_DB_PATH=
# Set only to the exact trusted reverse-proxy hop count when deployed behind one.
TASK_TRUST_PROXY_HOPS=

# Agent fees (USDC on Arc). Set AGENT_FEE_ENABLED=false to make the Agent free again.
AGENT_FEE_ENABLED=true
# Wallet that receives Agent top-ups.
AGENT_FEE_ADDRESS=0x16299b74c616994eaecb9b20e37d369d5d62586b
# Free AI messages per wallet per day (UTC).
AGENT_CREDITS_FREE_PER_DAY=5
# Credits one AI answer costs.
AGENT_CREDITS_PER_MESSAGE=3
# Wallets that never pay, comma-separated (for example your own while testing).
AGENT_FEE_FREE_ADDRESSES=
# Persistent SQLite file for balances and payments (defaults next to the other data files).
AGENT_CREDITS_DB_PATH=
